{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6f9c9ed6-7a1f-44e4-a6c9-f82ec3421d15","database_name": "web-app-2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7b37e968b88d409bad30eaf791081da7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
